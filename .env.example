# Copie para .env.local. Nunca publique credenciais reais neste arquivo.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Obrigatorio tambem na Vercel/Production: segredo aleatorio com pelo menos 32 caracteres.
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
# Apenas para cadastrar o primeiro administrador de uma instalacao vazia.
# Desnecessario para a instalacao atual. Nao habilita cadastro publico no painel.
BOOTSTRAP_ADMIN_TOKEN=
# Geração de matérias via API da OpenAI, sem usar AI_GATEWAY_API_KEY.
OPENAI_API_KEY=
OPENAI_EDITORIAL_MODEL=gpt-4.1-mini
# Mantenha desativada até validar a geração, o banco e o autor na produção.
AUTOMATION_ENABLED=false
AUTOMATION_AUTHOR_ID=
# Segredo exclusivo dos agendamentos, com pelo menos 32 caracteres.
CRON_SECRET=
